# --- required ---------------------------------------------------------------
# Anthropic (research synthesis + writing). Create at https://platform.claude.com/
ANTHROPIC_API_KEY=sk-ant-...
# Tavily (web search + page extraction). Create at https://app.tavily.com/
TAVILY_API_KEY=tvly-...

# --- optional ---------------------------------------------------------------
# Best model: research synthesis, drafting, first fix pass. Fast model: JD extraction, employer profiles, later fix passes.
CLAUDE_MODEL=claude-opus-5
CLAUDE_FAST_MODEL=claude-sonnet-5
# "deep" runs ~12 searches per job; "quick" runs 5 (cheaper, less company context)
RESEARCH_DEPTH=deep
